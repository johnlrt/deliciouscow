PUBLIC_ORIGIN=https://cordova.example.invalid
MONERO_NETWORK=mainnet
DEV_MODE=0
DEV_INSECURE_COOKIES=0
REDIS_ADDR=redis:6379
REDIS_REQUIRE_REPLICA=1
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
TOKENIZER_URL=http://tokenizer:8090
TOKENIZER_SECRET_FILE=/run/secrets/tokenizer_secret
API_KEY_PEPPER_FILE=/run/secrets/api_key_pepper
NODE_SECRET_MASTER_KEY=replace-with-64-hex-chars-32-bytes
MONERO_WALLET_RPC=http://monero-wallet-rpc:18082
