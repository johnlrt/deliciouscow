{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordova.invalid/contracts/ws/v1.schema.json",
  "title": "Cordova WebSocket Protocol v1",
  "description": "C3 node and C4 dashboard live frames. Direction is listed below; sequence and session ownership are enforced by the relevant socket state machine.",
  "x-frame-limits": {
    "text-only": true,
    "compression": false,
    "max-frame-bytes": 1048576,
    "max-delta-text-bytes": 16384,
    "outgoing-queue-frames": 32,
    "outgoing-queue-bytes": 524288
  },
  "x-message-directions": {
    "node": {
      "node-to-server": ["hello", "heartbeat", "model.state", "model.accepted", "model.progress", "model.ready", "model.reject", "inference.accepted", "inference.delta", "inference.complete", "inference.cancelled", "benchmark.delta", "benchmark.result", "drain.ack", "goodbye"],
      "server-to-node": ["welcome", "heartbeat.ack", "catalog.get", "catalog.snapshot", "model.query", "model.load", "model.download", "inference.start", "inference.cancel", "benchmark.start", "drain"],
      "both": ["error"]
    },
    "live": {
      "front-to-server": ["live.auth", "live.subscribe"],
      "server-to-front": ["live.ready", "live.event", "live.resync"],
      "both": ["live.ping", "live.pong", "error"]
    }
  },
  "x-session-invariant": "session_id is null only on hello and live.auth; every other frame uses the current fenced session.",
  "x-request-id-invariant": "request_id may be null only for unsolicited connection/state events; control replies echo their request ID, and inference frames share the logical request ID.",
  "x-sequence-invariant": "seq starts at 1 and strictly increases per direction per connection; reconnect creates a new session and resets seq.",
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "ModelSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "TokenCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "Hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "backend", "gpu_name", "reported_total_vram_bytes", "reported_free_vram_bytes", "ram_bytes"],
      "properties": {
        "platform": { "enum": ["linux", "windows", "macos"] },
        "arch": { "enum": ["x86_64", "aarch64"] },
        "backend": { "enum": ["cuda", "metal", "vulkan", "cpu"] },
        "gpu_name": { "type": ["string", "null"] },
        "reported_total_vram_bytes": { "type": "integer", "minimum": 0 },
        "reported_free_vram_bytes": { "type": "integer", "minimum": 0 },
        "ram_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "NodeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "state", "active_slots", "max_slots", "verified_capacity_bytes", "updated_at"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "state": { "enum": ["loaded", "on_disk", "absent", "downloading", "loading", "failed"] },
        "active_slots": { "type": "integer", "minimum": 0 },
        "max_slots": { "type": "integer", "minimum": 0 },
        "verified_capacity_bytes": { "type": "integer", "minimum": 0 },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Money": {
      "type": "string",
      "pattern": "^(?:0|[1-8][0-9]{0,18}|9(?:0{0,18}))$",
      "description": "Canonical piconero decimal string capped at 9000000000000000000."
    },
    "ModelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object", "created", "owned_by", "context_tokens", "max_output_tokens", "input_rate_piconero_per_million", "output_rate_piconero_per_million", "owner_share_bps", "price_version"],
      "properties": {
        "id": { "$ref": "#/$defs/ModelSlug" },
        "object": { "const": "model" },
        "created": { "type": "integer", "minimum": 0 },
        "owned_by": { "const": "cordova" },
        "context_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_rate_piconero_per_million": { "$ref": "#/$defs/Money" },
        "output_rate_piconero_per_million": { "$ref": "#/$defs/Money" },
        "owner_share_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "price_version": { "$ref": "#/$defs/Id" }
      }
    },
    "CatalogManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "artifact_url", "artifact_sha256", "artifact_size_bytes", "tokenizer_sha256", "template_sha256", "llama_commit", "add_bos", "min_memory_bytes", "memory_per_slot_bytes", "license_spdx", "version", "signature"],
      "properties": {
        "model": { "$ref": "#/$defs/ModelDefinition" },
        "artifact_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "artifact_sha256": { "$ref": "#/$defs/Hash" },
        "artifact_size_bytes": { "type": "integer", "minimum": 1 },
        "tokenizer_sha256": { "$ref": "#/$defs/Hash" },
        "template_sha256": { "$ref": "#/$defs/Hash" },
        "llama_commit": { "type": "string", "minLength": 7, "maxLength": 64 },
        "add_bos": { "type": "boolean" },
        "min_memory_bytes": { "type": "integer", "minimum": 1 },
        "memory_per_slot_bytes": { "type": "integer", "minimum": 1 },
        "license_spdx": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/Id" },
        "signature": { "type": "string", "contentEncoding": "base64", "minLength": 1 }
      }
    },
    "NodeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["unsupported_version", "invalid_message", "unauthenticated", "replayed_message", "stale_session", "stale_lease", "model_not_found", "catalog_mismatch", "insufficient_memory", "no_capacity", "download_failed", "load_timeout", "inference_failed", "timeout", "cancelled", "output_limit", "rate_limited", "internal_error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "retryable": { "type": "boolean" }
      }
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "message_id", "request_id", "session_id", "seq", "sent_at", "payload", "error"],
      "properties": {
        "v": { "const": 1 },
        "type": { "type": "string" },
        "message_id": { "$ref": "#/$defs/Id" },
        "request_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "session_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "sent_at": { "$ref": "#/$defs/Timestamp" },
        "payload": { "type": "object" },
        "error": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/NodeError" }] }
      }
    },
    "HelloPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "node_version", "protocol_versions", "hardware", "hwid_hash"],
      "properties": {
        "node_id": { "$ref": "#/$defs/Id" },
        "node_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "const": 1 } },
        "hardware": { "$ref": "#/$defs/Hardware" },
        "hwid_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "WelcomePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "heartbeat_interval_ms", "heartbeat_timeout_ms", "catalog_version", "max_frame_bytes", "connection_expires_at"],
      "properties": {
        "session_id": { "$ref": "#/$defs/Id" },
        "heartbeat_interval_ms": { "const": 15000 },
        "heartbeat_timeout_ms": { "const": 45000 },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "max_frame_bytes": { "const": 1048576 },
        "connection_expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "HeartbeatPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["active_leases", "hardware", "models"],
      "properties": {
        "active_leases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "hardware": { "$ref": "#/$defs/Hardware" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/NodeModel" } }
      }
    },
    "HeartbeatAckPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["server_time", "session_expires_at"],
      "properties": { "server_time": { "$ref": "#/$defs/Timestamp" }, "session_expires_at": { "$ref": "#/$defs/Timestamp" } }
    },
    "CatalogGetPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["known_version"],
      "properties": { "known_version": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } }
    },
    "CatalogSnapshotPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "models"],
      "properties": { "version": { "$ref": "#/$defs/Id" }, "models": { "type": "array", "items": { "$ref": "#/$defs/CatalogManifest" } } }
    },
    "ModelRefPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "catalog_version"],
      "properties": { "model_id": { "$ref": "#/$defs/ModelSlug" }, "catalog_version": { "$ref": "#/$defs/Id" } }
    },
    "ModelStatePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "state", "artifact_sha256", "active_slots", "max_slots", "reason_code"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "state": { "enum": ["loaded", "on_disk", "absent"] },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "active_slots": { "type": "integer", "minimum": 0 },
        "max_slots": { "type": "integer", "minimum": 0 },
        "reason_code": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "ModelCommandPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "catalog_version", "command_id", "deadline_at"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "command_id": { "$ref": "#/$defs/Id" },
        "deadline_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ModelAcceptedPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "command_id", "operation"],
      "properties": { "model_id": { "$ref": "#/$defs/ModelSlug" }, "command_id": { "$ref": "#/$defs/Id" }, "operation": { "enum": ["load", "download"] } }
    },
    "ModelProgressPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "command_id", "phase", "completed_bytes", "total_bytes"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "command_id": { "$ref": "#/$defs/Id" },
        "phase": { "enum": ["downloading", "verifying", "loading"] },
        "completed_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "ModelReadyPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "command_id", "artifact_sha256", "tokenizer_sha256", "template_sha256", "max_slots", "verified_capacity_bytes"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "command_id": { "$ref": "#/$defs/Id" },
        "artifact_sha256": { "$ref": "#/$defs/Hash" },
        "tokenizer_sha256": { "$ref": "#/$defs/Hash" },
        "template_sha256": { "$ref": "#/$defs/Hash" },
        "max_slots": { "type": "integer", "minimum": 1 },
        "verified_capacity_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "ModelRejectPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "command_id", "code", "retryable"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "command_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "code": { "enum": ["insufficient_memory", "disk_full", "unsupported_backend", "catalog_mismatch", "download_failed", "load_timeout", "busy"] },
        "retryable": { "type": "boolean" }
      }
    },
    "InferenceStartPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id", "model_id", "catalog_version", "input_token_ids", "input_tokens", "max_tokens", "parameters", "deadline_at", "kind"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/Id" },
        "lease_id": { "$ref": "#/$defs/Id" },
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "input_token_ids": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "type": "integer", "minimum": 0, "maximum": 2147483647 } },
        "input_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "parameters": {
          "type": "object", "additionalProperties": false,
          "required": ["temperature", "top_p", "stop", "seed"],
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "stop": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 128 } },
            "seed": { "type": ["integer", "null"], "minimum": 0, "maximum": 2147483647 }
          }
        },
        "deadline_at": { "$ref": "#/$defs/Timestamp" },
        "kind": { "enum": ["user", "shadow"] }
      }
    },
    "AttemptLeasePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id"],
      "properties": { "attempt_id": { "$ref": "#/$defs/Id" }, "lease_id": { "$ref": "#/$defs/Id" } }
    },
    "InferenceDeltaPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id", "chunk_index", "text"],
      "properties": { "attempt_id": { "$ref": "#/$defs/Id" }, "lease_id": { "$ref": "#/$defs/Id" }, "chunk_index": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "maxLength": 16384 } }
    },
    "InferenceCompletePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id", "last_chunk_index", "finish_reason", "claimed_input_tokens", "claimed_output_tokens"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/Id" },
        "lease_id": { "$ref": "#/$defs/Id" },
        "last_chunk_index": { "type": ["integer", "null"], "minimum": 0 },
        "finish_reason": { "enum": ["stop", "length"] },
        "claimed_input_tokens": { "$ref": "#/$defs/TokenCount" },
        "claimed_output_tokens": { "$ref": "#/$defs/TokenCount" }
      }
    },
    "InferenceCancelPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "lease_id", "reason"],
      "properties": { "attempt_id": { "$ref": "#/$defs/Id" }, "lease_id": { "$ref": "#/$defs/Id" }, "reason": { "enum": ["client_cancelled", "deadline", "node_revoked", "output_limit", "server_shutdown", "superseded"] } }
    },
    "BenchmarkStartPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_id", "model_id", "catalog_version", "input_token_ids", "max_tokens", "seed", "required_concurrency", "leases", "deadline_at"],
      "properties": {
        "benchmark_id": { "$ref": "#/$defs/Id" },
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "input_token_ids": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "type": "integer", "minimum": 0, "maximum": 2147483647 } },
        "max_tokens": { "const": 256 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "required_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "leases": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["slot_index", "lease_id"],
            "properties": { "slot_index": { "type": "integer", "minimum": 0, "maximum": 63 }, "lease_id": { "$ref": "#/$defs/Id" } }
          }
        },
        "deadline_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "BenchmarkDeltaPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_id", "slot_index", "lease_id", "chunk_index", "text"],
      "properties": { "benchmark_id": { "$ref": "#/$defs/Id" }, "slot_index": { "type": "integer", "minimum": 0 }, "lease_id": { "$ref": "#/$defs/Id" }, "chunk_index": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "maxLength": 16384 } }
    },
    "BenchmarkResultPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_id", "slots", "reported_peak_vram_bytes", "completed_slots"],
      "properties": {
        "benchmark_id": { "$ref": "#/$defs/Id" },
        "slots": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["slot_index", "lease_id", "claimed_output_tokens", "finish_reason"],
            "properties": { "slot_index": { "type": "integer", "minimum": 0 }, "lease_id": { "$ref": "#/$defs/Id" }, "claimed_output_tokens": { "$ref": "#/$defs/TokenCount" }, "finish_reason": { "enum": ["stop", "length"] } }
          }
        },
        "reported_peak_vram_bytes": { "type": "integer", "minimum": 0 },
        "completed_slots": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "DrainPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline_at", "reason"],
      "properties": { "deadline_at": { "$ref": "#/$defs/Timestamp" }, "reason": { "enum": ["maintenance", "revoked", "upgrade"] } }
    },
    "LeaseListPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["active_leases"],
      "properties": { "active_leases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } } }
    },
    "GoodbyePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "active_leases"],
      "properties": { "reason": { "enum": ["shutdown", "upgrade"] }, "active_leases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } } }
    },
    "NodeErrorPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_type", "attempt_id", "lease_id", "command_id"],
      "properties": {
        "operation_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attempt_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "lease_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "command_id": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
      }
    },
    "LiveError": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": { "code": { "enum": ["invalid_message", "unauthenticated", "stale_session", "replayed_message", "internal_error"] }, "message": { "type": "string", "minLength": 1, "maxLength": 256 }, "retryable": { "type": "boolean" } }
    },
    "LiveErrorPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_type", "attempt_id", "lease_id", "command_id"],
      "properties": { "operation_type": { "type": "string", "minLength": 1, "maxLength": 64 }, "attempt_id": { "type": "null" }, "lease_id": { "type": "null" }, "command_id": { "type": "null" } }
    },
    "LiveSubscribePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["topics", "last_event_id"],
      "properties": { "topics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["nodes", "usage", "billing"] } }, "last_event_id": { "type": ["string", "null"], "maxLength": 256 } }
    },
    "LiveEventPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "topic", "resource_id", "revision", "action"],
      "properties": { "event_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "topic": { "enum": ["nodes", "usage", "billing"] }, "resource_id": { "$ref": "#/$defs/Id" }, "revision": { "type": "integer", "minimum": 1 }, "action": { "const": "invalidate" } }
    },
    "LiveResyncPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "enum": ["cursor_expired", "gap", "slow_consumer"] } }
    },
    "LiveTimePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["time"],
      "properties": { "time": { "$ref": "#/$defs/Timestamp" } }
    },
    "NodeVariant": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "hello" }, "session_id": { "type": "null" }, "payload": { "$ref": "#/$defs/HelloPayload" }, "error": { "type": "null" } } }] },
        { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "welcome" }, "payload": { "$ref": "#/$defs/WelcomePayload" }, "error": { "type": "null" } } }] },
        { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "heartbeat" }, "payload": { "$ref": "#/$defs/HeartbeatPayload" }, "error": { "type": "null" } } }] },
