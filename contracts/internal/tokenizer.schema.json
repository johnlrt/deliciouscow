{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordova.invalid/contracts/internal/tokenizer.schema.json",
  "title": "Cordova trusted tokenizer service C9",
  "description": "Private helper request and response payloads. This schema does not make the service public or perform tokenization itself.",
  "x-authentication": {
    "header": "Authorization",
    "scheme": "Bearer",
    "credential-scope": "tokenizer-helper-only",
    "public-edge-exposed": false
  },
  "x-limits": {
    "body-bytes": 1048576,
    "messages-per-prepare": 128,
    "message-text-bytes": 262144,
    "count-text-bytes": 1048576,
    "concurrent-operations-per-model": 2,
    "queued-operations": 100,
    "max-queue-wait-ms": 500,
    "operation-deadline-ms": 2000,
    "overload-status": 503,
    "overload-retry-after-seconds": 1
  },
  "x-runtime-rules": {
    "artifact": "Keep the admitted GGUF read-only and use the catalog-pinned tokenizer/template/BOS policy.",
    "inference": "Do not run inference in the tokenizer helper.",
    "content": "Keep messages, token IDs and counted text in memory; disable content logs and prompt/KV reuse.",
    "cleanup": "Erase allocated native slots after each operation and restart the child if cleanup fails.",
    "output-counting": "Count the complete concatenated decoded text with add_special=false and parse_special=false."
  },
  "x-endpoints": {
    "POST /internal/tokenizer/prepare": {
      "request": "#/$defs/PrepareRequest",
      "response": "#/$defs/PrepareResponse",
      "success-status": 200,
      "failure-statuses": [400, 404, 409, 503]
    },
    "POST /internal/tokenizer/count": {
      "request": "#/$defs/CountRequest",
      "response": "#/$defs/CountResponse",
      "success-status": 200,
      "failure-statuses": [400, 404, 409, 503]
    },
    "GET /healthz": {"response": "#/$defs/Health", "success-status": 200},
    "GET /readyz": {"response": "#/$defs/Ready", "success-status": 200}
  },
  "$defs": {
    "ModelSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Id": {
      "type": "string", "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Message": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "maxLength": 262144 }
      }
    },
    "PrepareRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "catalog_version", "messages"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "messages": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/Message" } }
      }
    },
    "PrepareResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["input_token_ids", "input_tokens", "context_tokens", "tokenizer_sha256", "template_sha256"],
      "properties": {
        "input_token_ids": { "type": "array", "minItems": 1, "maxItems": 8192, "items": { "type": "integer", "minimum": 0, "maximum": 2147483647 } },
        "input_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "context_tokens": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "tokenizer_sha256": { "$ref": "#/$defs/Hash" },
        "template_sha256": { "$ref": "#/$defs/Hash" }
      }
    },
    "CountRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "catalog_version", "text"],
      "properties": {
        "model_id": { "$ref": "#/$defs/ModelSlug" },
        "catalog_version": { "$ref": "#/$defs/Id" },
        "text": { "type": "string", "maxLength": 1048576 }
      }
    },
    "CountResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens"],
      "properties": { "tokens": { "type": "integer", "minimum": 0, "maximum": 2147483647 } }
    },
    "ErrorCode": {
      "type": "string",
      "enum": ["invalid_request", "unauthenticated", "not_found", "conflict", "tokenizer_unavailable", "context_exceeded", "rate_limited"]
    },
    "ErrorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["error", "request_id"],
      "properties": {
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["message", "type", "param", "code"],
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "type": { "enum": ["invalid_request_error", "authentication_error", "server_error"] },
            "param": { "type": ["string", "null"] },
            "code": { "$ref": "#/$defs/ErrorCode" }
          }
        },
        "request_id": { "$ref": "#/$defs/Id" }
      }
    },
    "Health": {
      "type": "object", "additionalProperties": false,
      "required": ["status"], "properties": { "status": { "const": "ok" } }
    },
    "Ready": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "catalog_version", "models"],
      "properties": {
        "status": { "enum": ["ready", "not_ready"] },
        "catalog_version": { "type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/ModelSlug" } }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/PrepareRequest" },
    { "$ref": "#/$defs/PrepareResponse" },
    { "$ref": "#/$defs/CountRequest" },
    { "$ref": "#/$defs/CountResponse" },
    { "$ref": "#/$defs/ErrorResponse" },
    { "$ref": "#/$defs/Health" },
    { "$ref": "#/$defs/Ready" }
  ]
}
